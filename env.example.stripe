# Variables Stripe à configurer dans Lovable Cloud (Secrets)
# ou dans .env pour le développement local

# Clé secrète Stripe (commence par sk_test_ ou sk_live_)
STRIPE_SECRET_KEY=sk_test_...

# Secret du webhook Stripe (commence par whsec_)
# Obtenu lors de la création du webhook endpoint dans le dashboard Stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# URL publique du site (pour les redirections Checkout)
SITE_URL=https://pro-gestion-coeur.lovable.app
